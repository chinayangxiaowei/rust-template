# Rebrand configuration for this template.
#
# A repository created from this template still carries the identity of the
# project it was copied from (oxidizer): copyright holder, project name, GitHub
# URLs, a Codecov token and Microsoft community files. `just rebrand` replaces
# them with your own, as described below.
#
# Usage:
#   1. Fill in the Values section. Normally that is the only part you edit.
#   2. just rebrand          # preview: lists every change, writes nothing
#   3. just rebrand apply    # writes the changes
#   4. just rebrand check    # fails if any upstream identity is left
#
# What is never changed, whatever this file says:
#   - Files that cargo anvil owns (listed as [[file]] in .anvil.lock).
#   - Text between `>>> anvil-managed:` and `<<< anvil-managed:` markers.
#   Both are regenerated by `cargo anvil`; editing them would make every later
#   `cargo anvil` run report them as locally modified. They keep the upstream
#   license header, which is why .cargo-heather.toml excludes justfiles/anvil.
#
# Running `apply` twice is safe: the second run finds nothing to change.
#
# Syntax: this is a PowerShell data file. Strings in single quotes are taken
# literally (write '' for one quote). @' ... '@ is a multi-line string; the
# closing '@ must start its own line. In Rules and Files, ${name} is replaced
# with the matching entry from Values.

@{
    # ---------------------------------------------------------------------
    # Your project's identity. Every ${name} below refers to one of these.
    # ---------------------------------------------------------------------
    Values = @{
        # Copyright holder written into license headers and LICENSE.
        org            = 'Example Corp'

        # Project display name, used as "The <project> Project".
        project        = 'Example'

        # Lower-case form of project, used in Markdown anchors (#the-<slug>-project).
        project_slug   = 'example'

        # GitHub owner and repository name; badges and links use
        # https://github.com/<owner>/<repo>.
        owner          = 'example-org'
        repo           = 'example-repo'

        # Contact addresses for the code of conduct and security reports.
        conduct_email  = 'opensource@example.com'
        security_email = 'security@example.com'
    }

    # ---------------------------------------------------------------------
    # Text replacements, applied to every tracked text file except those
    # under Exclude and those owned by cargo anvil.
    #
    # - Matching is literal and case-sensitive.
    # - All rules run in a single pass. Where several match at the same place,
    #   the longest From wins, so specific rules can sit next to the catch-all
    #   'Oxidizer' and 'oxidizer' rules at the end. Replaced text is never
    #   matched again.
    # - A From that spans lines matches files with LF or CRLF line endings.
    # ---------------------------------------------------------------------
    Rules = @(
        # License headers in every source and config file, and LICENSE itself.
        # .cargo-heather.toml holds the same line, so the header check follows.
        @{ From = 'Copyright (c) Microsoft Corporation.'; To = 'Copyright (c) ${org}.' }

        # README title, Cargo `authors` and the crate README footer.
        @{ From = 'The Oxidizer Project'; To = 'The ${project} Project' }

        # README table-of-contents anchor generated from that title.
        @{ From = 'the-oxidizer-project'; To = 'the-${project_slug}-project' }

        # GitHub, raw-content, docs-logo and Codecov URLs, and the release
        # script's owner/name example.
        @{ From = 'microsoft/oxidizer'; To = '${owner}/${repo}' }

        # Codecov badge token of the upstream project. Public repositories do
        # not need one; add your own here if your Codecov project is private.
        @{ From = '?token=FCUG0EL5TI'; To = '' }

        # README "Publishing Crates" section.
        @{ From = 'internal Microsoft automation'; To = 'internal ${org} automation' }

        # SUPPORT.md heading.
        @{ From = 'Microsoft Support Policy'; To = 'Support Policy' }

        # Issue template note aimed at Microsoft-internal engineers.
        @{
            From = '<!-- NOTE: If you''re a Microsoft-internal engineer working on the Oxidizer project, please use internal ADO work items instead of GitHub issues. This does not apply if you''re an external user. -->'
            To   = ''
        }

        # README "Trademarks" section: the Microsoft-specific paragraph. The
        # generic third-party sentence after it stays.
        @{
            From = @'
This project may contain trademarks or logos for projects, products, or services. Authorized use of Microsoft
trademarks or logos is subject to and must follow
[Microsoft's Trademark & Brand Guidelines](https://www.microsoft.com/en-us/legal/intellectualproperty/trademarks/usage/general).
Use of Microsoft trademarks or logos in modified versions of this project must not cause confusion or imply Microsoft
sponsorship.

'@
            To   = ''
        }

        # Catch-all for the remaining project name: logo alt text, docs titles,
        # crate keywords, DEVELOPMENT.md clone instructions, the cspell
        # dictionary name and path examples in docs and tests.
        @{ From = 'Oxidizer'; To = '${project}' }
        @{ From = 'oxidizer'; To = '${repo}' }
    )

    # ---------------------------------------------------------------------
    # Whole-file replacements, for files whose upstream text cannot be fixed
    # line by line. The file is overwritten with Content; Rules do not run on
    # it. Remove an entry to keep that file as it is.
    # ---------------------------------------------------------------------
    Files = @(
        # Upstream: Microsoft Open Source Code of Conduct.
        @{
            Path    = 'CODE_OF_CONDUCT.md'
            Content = @'
# Code of Conduct

This project has adopted the [Contributor Covenant](https://www.contributor-covenant.org/version/2/1/code_of_conduct/), version 2.1.

Report unacceptable behavior to [${conduct_email}](mailto:${conduct_email}).

'@
        }

        # Upstream: requires the Microsoft Contributor License Agreement.
        @{
            Path    = 'CONTRIBUTING.md'
            Content = @'
# Contributing

This project welcomes contributions and suggestions. See [DEVELOPMENT.md](DEVELOPMENT.md)
to set up your environment and [AGENTS.md](AGENTS.md) for the coding guidelines.

This project has adopted the [Code of Conduct](CODE_OF_CONDUCT.md).
Contact [${conduct_email}](mailto:${conduct_email}) with any questions or comments.

'@
        }

        # Upstream: routes reports to the Microsoft Security Response Center.
        @{
            Path    = 'SECURITY.md'
            Content = @'
# Security

**Please do not report security vulnerabilities through public GitHub issues.**

Report them privately through
[GitHub security advisories](https://github.com/${owner}/${repo}/security/advisories/new),
or by email to [${security_email}](mailto:${security_email}).

Please include the affected crate and version, steps to reproduce, and the
impact you expect. You should receive a response within a few working days.

'@
        }
    )

    # ---------------------------------------------------------------------
    # Paths that are neither rewritten nor checked. Globs: * matches within one
    # directory level, ** across levels, ? one character.
    # ---------------------------------------------------------------------
    Exclude = @(
        # Azure DevOps pipelines that only run inside the upstream organization.
        # Kept as reference; edit or delete them by hand.
        '.ado/**'

        # Generated lock files.
        '.anvil.lock'
        'Cargo.lock'

        # This file: its From strings are the upstream identity on purpose.
        'rebrand.psd1'
    )

    # ---------------------------------------------------------------------
    # `just rebrand check` reports every line (outside Exclude and anvil-owned
    # text) that matches a Patterns entry and no Allow entry. Both lists are
    # case-sensitive regular expressions; prefix with (?i) to ignore case.
    # ---------------------------------------------------------------------
    Residue = @{
        Patterns = @(
            '(?i)oxidizer'
            '(?i)microsoft'
            '(?i)ox-tools'
            'FCUG0EL5TI'
        )

        # References to Microsoft that are not this project's identity.
        Allow = @(
            # AGENTS.md: the coding guidelines this template follows.
            'Microsoft Rust Guidelines'

            # DEVELOPMENT.md: where to download Visual Studio, PowerShell and Ubuntu.
            'visualstudio\.microsoft\.com'
            'learn\.microsoft\.com'
            'apps\.microsoft\.com'
            'Microsoft Store'

            # .vscode settings: a link to a VS Code issue.
            'github\.com/microsoft/vscode'

            # Release tooling tests that locate the Visual Studio toolchain.
            'Microsoft Visual Studio'
            'Microsoft\.VisualStudio'

            # .spelling: dictionary entry.
            '^microsoft\.com\s*$'
        )
    }
}
